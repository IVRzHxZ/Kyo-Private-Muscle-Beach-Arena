local function runContinuousToolLogic(localPlayer)
    local char = localPlayer.Character
    if not char then return end

    -- Tool Verification & Auto-Equipping Logic
    local tool = char:FindFirstChild("Punch")
    if not tool then
        local backpack = localPlayer:FindFirstChild("Backpack")
        if backpack then
            local bpTool = backpack:FindFirstChild("Punch")
            if bpTool then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then
                    hum:EquipTool(bpTool)
                end
            end
        end
    end

    -- Tool Activation
    local activeTool = char:FindFirstChild("Punch")
    if activeTool then
        activeTool:Activate()
    end
end

-- Separate Hitbox and Remote Execution Handler
local function executeAttack(targetPlayer, localPlayer, localLeftHand)
    if targetPlayer.Character and targetPlayer.Character:FindFirstChild("Head") and localLeftHand then
        local targetHead = targetPlayer.Character.Head
        
        pcall(function()
            firetouchinterest(targetHead, localLeftHand, 0)
            task.wait(0.01)
            firetouchinterest(targetHead, localLeftHand, 1)
        end)
        
        pcall(function()
            localPlayer.muscleEvent:FireServer("punch", "leftHand")
            localPlayer.muscleEvent:FireServer("punch", "rightHand")
        end)
    end
end

