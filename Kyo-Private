local function isPlayerWhitelisted(targetName, localPlayer)
    if targetName == localPlayer.Name then return true end
    
    for _, whitelistedName in ipairs(whitelistTable) do
        if targetName == whitelistedName then return true end
    end
    
    for _, blacklistedName in ipairs(blacklistTable) do
        if targetName == blacklistedName then return false end
    end
    
    return false
end

