    StartTime = os.time(),
    Utils = {}
}

local Tracker = _G.LocalTracker

local TrackerTab = nil
pcall(function() TrackerTab = window:AddTab("Stats 📊") end)

local ClockLabel = TrackerTab:AddLabel("Session Time: 00:00:00")

Tracker.Utils.updateLabelText = function(name, content)
    local label = Tracker.Labels[name]
    if not label then return end
    local ok = pcall(function() label.Text = content end)
    if not ok then ok = pcall(function() label:SetText(content) end) end
    if not ok then pcall(function() label:UpdateLabel(content) end) end
end

Tracker.Utils.formatNumber = function(value)
    if not value or typeof(value) ~= "number" then return "0" end
    if value < 1000 then return tostring(math.floor(value)) end
    local index = math.floor(math.log10(value) / 3)
    local suffix = Tracker.Config.Suffixes[index] or ""
    return string.format("%.1f", value / (10 ^ (index * 3))):gsub("%.0$", "") .. suffix
end

Tracker.Utils.scanForStatFast = function(statName)
    if not LocalPlayer then return nil end
    local lowerTarget = string.lower(statName)
    
    local classicHubs = {"leaderstats", "leaderstats2", "Stats", "PlayerData", "Data", "Currency"}
    for i = 1, #classicHubs do
        local folder = LocalPlayer:FindFirstChild(classicHubs[i])
        if folder then
            local children = folder:GetChildren()
            for j = 1, #children do
                local child = children[j]
                if string.find(string.lower(child.Name), lowerTarget) and string.find(child.ClassName, "Value") then
                    return child
                end
            end
        end
    end

    local rootChildren = LocalPlayer:GetChildren()
    for i = 1, #rootChildren do
        local child = rootChildren[i]
        if string.find(string.lower(child.Name), lowerTarget) and string.find(child.ClassName, "Value") then
            return child
        elseif child:IsA("Folder") or child:IsA("Configuration") then
            local subChildren = child:GetChildren()
            for j = 1, #subChildren do
                local subChild = subChildren[j]
                if string.find(string.lower(subChild.Name), lowerTarget) and string.find(subChild.ClassName, "Value") then
                    return subChild
                end
            end
        end
    end
    
    return nil
end

Tracker.Utils.computeAndRenderStat = function(name, currentVal)
    local currentTime = os.time()
    local startVal = Tracker.StartStats[name]
    
    if not startVal then
        Tracker.StartStats[name] = currentVal
        startVal = currentVal
        Tracker.TotalGained[name] = 0
        Tracker.LastValues[name] = currentVal
        Tracker.LastUpdates[name] = currentTime
        Tracker.Rates[name] = 0
    end
    
    if not Tracker.TotalGained[name] then Tracker.TotalGained[name] = 0 end
    if not Tracker.LastValues[name] then Tracker.LastValues[name] = currentVal end
    if not Tracker.LastUpdates[name] then Tracker.LastUpdates[name] = currentTime end
    if not Tracker.Rates[name] then Tracker.Rates[name] = 0 end

    if currentVal < Tracker.LastValues[name] then
        local progressBeforeReset = math.max(Tracker.LastValues[name] - startVal, 0)
        Tracker.TotalGained[name] = Tracker.TotalGained[name] + progressBeforeReset
        Tracker.StartStats[name] = currentVal
        startVal = currentVal
    end

    local diff = currentVal - Tracker.LastValues[name]
    if diff > 0 then
        local timePassed = math.max(currentTime - Tracker.LastUpdates[name], 1)
        Tracker.Rates[name] = diff / timePassed
        Tracker.LastUpdates[name] = currentTime
    end
    
    Tracker.LastValues[name] = currentVal

    local currentGain = math.max(currentVal - startVal, 0)
    local gained = Tracker.TotalGained[name] + currentGain
    local formattedCurrent = Tracker.Utils.formatNumber(currentVal)
    local activeRate = Tracker.Rates[name] or 0
    
    if gained > 0 and activeRate > 0 then
        Tracker.Utils.updateLabelText(name, string.format(
            "%s: %s (+%s) | /m: %s | /h: %s | /d: %s | /w: %s",
            name, formattedCurrent, Tracker.Utils.formatNumber(gained),
            Tracker.Utils.formatNumber(activeRate * 60), Tracker.Utils.formatNumber(activeRate * 3600), 
            Tracker.Utils.formatNumber(activeRate * 86400), Tracker.Utils.formatNumber(activeRate * 604800)
        ))
    else
        Tracker.Utils.updateLabelText(name, string.format("%s: %s (+%s) | /m: 0 | /h: 0 | /d: 0 | /w: 0", name, formattedCurrent, Tracker.Utils.formatNumber(gained)))
    end
end

Tracker.Utils.bindObjectSignals = function(name, obj)
    Tracker.CachedObjects[name] = obj
    Tracker.StartStats[name] = tonumber(obj.Value) or 0
    Tracker.LastValues[name] = tonumber(obj.Value) or 0
    Tracker.TotalGained[name] = Tracker.TotalGained[name] or 0
    Tracker.LastUpdates[name] = os.time()
    Tracker.Rates[name] = 0
    
    if Tracker.Connections[name] then
        pcall(function() Tracker.Connections[name]:Disconnect() end)
    end
    
    Tracker.Connections[name] = obj.Changed:Connect(function(newVal)
        Tracker.Utils.computeAndRenderStat(name, tonumber(newVal) or 0)
    end)
    
    Tracker.Utils.computeAndRenderStat(name, Tracker.StartStats[name])
end

for i = 1, #Tracker.Config.Stats do
    local name = Tracker.Config.Stats[i]
    Tracker.StartStats[name] = 0
    
    local foundObj = Tracker.Utils.scanForStatFast(name)
    local currentText = name .. ": 0 (+0) | /m: 0 | /h: 0 | /d: 0 | /w: 0"
    
    if foundObj then
        local initialVal = tonumber(foundObj.Value) or 0
        Tracker.StartStats[name] = initialVal
        Tracker.LastValues[name] = initialVal
        currentText = string.format("%s: %s (+0) | /m: 0 | /h: 0 | /d: 0 | /w: 0", name, Tracker.Utils.formatNumber(initialVal))
    end
    
    pcall(function() Tracker.Labels[name] = TrackerTab:AddLabel(currentText) end)
    
    if foundObj then
        Tracker.Utils.bindObjectSignals(name, foundObj)
    end
end

task.spawn(function()
    while task.wait(1) do
        local elapsedSeconds = math.max(os.time() - Tracker.StartTime, 1)
        local currentTime = os.time()
        
        local hours = math.floor(elapsedSeconds / 3600)
        local minutes = math.floor((elapsedSeconds % 3600) / 60)
        local seconds = elapsedSeconds % 60
        pcall(function() ClockLabel.Text = string.format("Session Time: %02d:%02d:%02d", hours, minutes, seconds) end)
        
        for i = 1, #Tracker.Config.Stats do
            local name = Tracker.Config.Stats[i]
            local obj = Tracker.CachedObjects[name]
            if obj then
                local lastActive = Tracker.LastUpdates[name] or currentTime
                if currentTime - lastActive > 4 then
                    Tracker.Rates[name] = math.max((Tracker.Rates[name] or 0) * 0.75, 0)
                    if Tracker.Rates[name] < 0.1 then Tracker.Rates[name] = 0 end
                    Tracker.Utils.computeAndRenderStat(name, tonumber(obj.Value) or 0)
                end
            end
        end
    end
end)

