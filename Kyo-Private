end

-- Lag-Free, Stripped Down Multiplier Formatter
local suffixes = {"K", "M", "B", "T", "QA", "QI"}
local function formatNumber(value)
    if not value or typeof(value) ~= "number" then return "0" end
    if value < 1000 then return tostring(math.floor(value)) end
    local index = math.floor(math.log10(value) / 3)
    local suffix = suffixes[index] or ""
    return string.format("%.1f", value / (10 ^ (index * 3))):gsub("%.0$", "") .. suffix
end

-- Optimized Fast Static Scanner
local function scanForStatFast(statName)
    if not LocalPlayer then return nil end
    local lowerTarget = string.lower(statName)
    
    local classicHubs = {"leaderstats", "leaderstats2", "Stats", "PlayerData", "Data", "Currency"}
    for i = 1, #classicHubs do
        local folder = LocalPlayer:FindFirstChild(classicHubs[i])
        if folder then
            local children = folder:GetChildren()
            for j = 1, #children do
                local child = children[j]
                if string.find(string.lower(child.Name), lowerTarget) and string.find(child.ClassName, "Value") then
                    return child
                end
            end
        end
    end

    local rootChildren = LocalPlayer:GetChildren()
    for i = 1, #rootChildren do
        local child = rootChildren[i]
        if string.find(string.lower(child.Name), lowerTarget) and string.find(child.ClassName, "Value") then
            return child
        elseif child:IsA("Folder") or child:IsA("Configuration") then
            local subChildren = child:GetChildren()
            for j = 1, #subChildren do
                local subChild = subChildren[j]
                if string.find(string.lower(subChild.Name), lowerTarget) and string.find(subChild.ClassName, "Value") then
                    return subChild
                end
            end
        end
    end
    
    return nil
end

-- Hyper-Optimized Display Writer (No more gained / elapsedSeconds!)
local function computeAndRenderStat(name, currentVal)
    local currentTime = os.time()
    local startVal = startingStats[name]
    
    if not startVal then
        startingStats[name] = currentVal
        startVal = currentVal
        totalGainedSession[name] = 0
        lastKnownValues[name] = currentVal
        lastUpdateTimes[name] = currentTime
        statRatesPerSecond[name] = 0
    end
    
    if not totalGainedSession[name] then totalGainedSession[name] = 0 end
    if not lastKnownValues[name] then lastKnownValues[name] = currentVal end
    if not lastUpdateTimes[name] then lastUpdateTimes[name] = currentTime end
    if not statRatesPerSecond[name] then statRatesPerSecond[name] = 0 end

    -- REBIRTH DETECTED: Handles stat resets cleanly
    if currentVal < lastKnownValues[name] then
        local progressBeforeReset = math.max(lastKnownValues[name] - startVal, 0)
        totalGainedSession[name] = totalGainedSession[name] + progressBeforeReset
        
        startingStats[name] = currentVal
        startVal = currentVal
    end

    -- DELTA REAL-TIME RATE CALCULATION
    local diff = currentVal - lastKnownValues[name]
    if diff > 0 then
        local timePassed = math.max(currentTime - lastUpdateTimes[name], 1)
        statRatesPerSecond[name] = diff / timePassed
        lastUpdateTimes[name] = currentTime
    end
    
    lastKnownValues[name] = currentVal

    local currentGain = math.max(currentVal - startVal, 0)
    local gained = totalGainedSession[name] + currentGain
    local formattedCurrent = formatNumber(currentVal)
    
    -- Real-time rate scaling based on actual tick increments
    local activeRate = statRatesPerSecond[name]
    
    if gained > 0 and activeRate > 0 then
        local perMinute = activeRate * 60
        local perHour   = activeRate * 3600
        local perDay    = activeRate * 86400
        local perWeek   = activeRate * 604800

        updateLabelText(name, string.format(
            "%s: %s (+%s) | /m: %s | /h: %s | /d: %s | /w: %s",
            name, formattedCurrent, formatNumber(gained),
            formatNumber(perMinute), formatNumber(perHour), formatNumber(perDay), formatNumber(perWeek)
        ))
    else
        -- Kapag nakatigil ang farm, ipapakita lang ang kasalukuyang total gained nang hindi nag-zi-zero ang text format
        updateLabelText(name, string.format("%s: %s (+%s) | /m: 0 | /h: 0 | /d: 0 | /w: 0", name, formattedCurrent, formatNumber(gained)))
    end
end

-- Bind instant data signals cleanly with 0 loop overhead
local function bindObjectSignals(name, obj)
    cachedObjects[name] = obj
    startingStats[name] = tonumber(obj.Value) or 0
    lastKnownValues[name] = tonumber(obj.Value) or 0
    totalGainedSession[name] = totalGainedSession[name] or 0
    lastUpdateTimes[name] = os.time()
    statRatesPerSecond[name] = 0
    
    if liveConnections[name] then
        pcall(function() liveConnections[name]:Disconnect() end)
    end
    
    liveConnections[name] = obj.Changed:Connect(function(newVal)
        computeAndRenderStat(name, tonumber(newVal) or 0)
    end)
    
    computeAndRenderStat(name, startingStats[name])
end

