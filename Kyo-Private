-- Logic Variables
local antiLagEnabled = false
local originalMaterials = {}
local lighting = game:GetService("Lighting")

-- Helper function to optimize individual assets
local function optimizePart(part)
    if part:IsA("BasePart") and not part:IsA("MeshPart") then
        -- Backup original properties to restore them later
        if not originalMaterials[part] then
            originalMaterials[part] = {
                Material = part.Material,
                Reflectance = part.Reflectance
            }
        end
        part.Material = Enum.Material.SmoothPlastic
        part.Reflectance = 0
    elseif part:IsA("Decal") or part:IsA("Texture") then
        if not originalMaterials[part] then
            originalMaterials[part] = {Transparency = part.Transparency}
        end
        part.Transparency = 1
    elseif part:IsA("ParticleEmitter") or part:IsA("Trail") then
        if not originalMaterials[part] then
            originalMaterials[part] = {Enabled = part.Enabled}
        end
        part.Enabled = false
    end
end

-- Add the Toggle Switch inside the UI
misc:AddSwitch("Anti-Lag", function(state)
    antiLagEnabled = state
    
    if antiLagEnabled then
        -- 1. Optimize existing assets in the world
        for _, v in pairs(workspace:GetDescendants()) do
            optimizePart(v)
        end
        
        -- 2. Downgrade lighting and render quality
        lighting.GlobalShadows = false
        lighting.FogEnd = 9e9
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        
        library:CreateNotification("Anti-Lag", "FPS Boost Activated! Visuals minimized.", 4)
    else
        -- 3. Restore original visuals perfectly
        for part, props in pairs(originalMaterials) do
            if part and part.Parent then
                for prop, val in pairs(props) do
                    part[prop] = val
                end
            end
        end
        table.clear(originalMaterials)
        
        lighting.GlobalShadows = true
        settings().Rendering.QualityLevel = Enum.QualityLevel.Automatic
        
        library:CreateNotification("Anti-Lag", "Visuals restored to normal.", 4)
    end
end)

-- Optimize new assets that load dynamically while active
workspace.DescendantAdded:Connect(function(descendant)
    if antiLagEnabled then
        task.wait()
        optimizePart(descendant)
    end
end)

