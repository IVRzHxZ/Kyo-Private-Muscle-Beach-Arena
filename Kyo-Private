local statRatesPerSecond = {} -- Dito na i-se-save ang real-time speed ng farm mo
local lastUpdateTimes = {}

local function updateLabelText(name, content)
    local label = My_UI_Labels[name]
    if not label then return end
    local ok = pcall(function() label.Text = content end)
    if not ok then ok = pcall(function() label:SetText(content) end) end
